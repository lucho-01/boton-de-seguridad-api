{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "*.pem": "deny",
      "*.key": "deny",
      "*.p12": "deny",
      "*.keystore": "deny",
      "*.jks": "deny",
      "*.mobileprovision": "deny",
      "google-services.json": "deny",
      "GoogleService-Info.plist": "deny",
      "credentials.json": "deny",
      "*service-account*.json": "deny",
      "*firebase-adminsdk*.json": "deny",
      "secrets/**": "deny",
      "data/**": "deny",
      "../*": "deny"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "*.keystore": "deny",
      "*.jks": "deny",
      "*.p12": "deny",
      "secrets/**": "deny",
      "data/**": "deny",
      "../*": "deny",
      "opencode.json": "ask",
      "AGENTS.md": "ask",
      ".opencode/**": "ask",
      "app.json": "ask",
      "eas.json": "ask"
    },
    "bash": {
      "*": "ask",
      "npm test*": "allow",
      "npm run test*": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm run check*": "allow",
      "npm run format*": "allow",
      "npm run build*": "allow",
      "npx vitest*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "cat *.env*": "deny",
      "type *.env*": "deny",
      "Get-Content *.env*": "deny",
      "grep * .env*": "deny",
      "printenv*": "deny",
      "env": "deny",
      "cd ..*": "deny",
      "git push*": "deny",
      "git remote add*": "deny",
      "git remote set-url*": "deny",
      "vercel*": "deny",
      "firebase *deploy*": "deny",
      "eas *": "deny",
      "expo publish*": "deny",
      "expo build*": "deny",
      "expo submit*": "deny",
      "expo update*": "deny",
      "curl*": "deny",
      "wget*": "deny",
      "npm publish*": "deny",
      "rm -rf*": "deny",
      "Remove-Item -Recurse*": "deny"
    },
    "webfetch": "ask"
  }
}
