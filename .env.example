# Copia este archivo a .env (nunca lo subas a git) y llena los valores.
# Los agentes de IA NO leen ni crean el .env real; solo este ejemplo.

# --- Firebase Admin (SECRETOS: Configuración del proyecto → Cuentas de servicio) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# La clave privada con los saltos de línea escritos como \n, entre comillas dobles.
FIREBASE_PRIVATE_KEY=

# --- Firebase Auth por REST (SECRETO: Configuración del proyecto → Tus apps → Web) ---
FIREBASE_WEB_API_KEY=

# --- Propias del proyecto (opcional) ---
# Orígenes permitidos para CORS, separados por coma. Vacío = solo la app móvil nativa (sin CORS).
CORS_ORIGINS=
