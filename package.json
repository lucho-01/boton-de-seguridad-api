{
  "name": "boton-de-seguridad-api",
  "version": "0.1.0",
  "private": true,
  "description": "API del proyecto 36 · Botón de seguridad con contactos de confianza",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "check:full": "npm run check && npm run build",
    "check:env": "tsx scripts/check-env.ts"
  },
  "dependencies": {
    "firebase-admin": "^14.5.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
