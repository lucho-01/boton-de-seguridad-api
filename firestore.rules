rules_version = '2';

// Firestore se usa SOLO desde la API con el Admin SDK.
// El cliente (app móvil) nunca tiene acceso directo: todas las reglas niegan.
// El Admin SDK omite estas reglas, así que la API sigue funcionando.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
